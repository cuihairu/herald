#!/bin/sh /etc/rc.common
# Herald scheduler procd init (herald package).
# Simple mode renders /var/etc/herald-config.yaml from /etc/config/herald on
# every start (UCI is the single source of truth); advanced mode runs
# heraldd on the full /etc/herald/config.yaml conffile untouched.
START=99
USE_PROCD=1

PROG=/usr/bin/heraldd
CONF_RENDERED=/var/etc/herald-config.yaml
CONF_ADVANCED=/etc/herald/config.yaml

# is_loopback <addr> — true when the bind address keeps auth optional.
is_loopback() {
	case "$1" in
		127.*|localhost|::1) return 0 ;;
		*) return 1 ;;
	esac
}

# render_config writes the simple-mode YAML to $CONF_RENDERED. Mirrors
# herald's own fail-closed rule: a non-loopback bind without an api key
# refuses to start (heraldd would reject it anyway; failing here says so
# before procd respawn churns).
render_config() {
	local http_addr http_port db_path api_key log_name tg_enabled tg_token tg_chat_id
	config_get http_addr general http_addr '127.0.0.1'
	config_get http_port general http_port '8080'
	config_get db_path general db_path '/etc/herald/store.db'
	config_get api_key general api_key ''
	config_get log_name general log_name 'herald'
	config_get tg_enabled telegram enabled '0'
	config_get tg_token telegram token ''
	config_get tg_chat_id telegram chat_id ''

	if ! is_loopback "$http_addr" && [ -z "$api_key" ]; then
		logger -t herald "non-loopback bind $http_addr:$http_port needs an api key (general.api_key); refusing to start"
		return 1
	fi

	# herald creates every provider it finds in the config, disabled or not —
	# an enabled Telegram with missing credentials would kill startup (the
	# factory demands token+chat_id unconditionally). Fail here, with the
	# reason in the log, instead of procd respawn churn.
	if [ "$tg_enabled" = "1" ] && { [ -z "$tg_token" ] || [ -z "$tg_chat_id" ]; }; then
		logger -t herald "telegram enabled but token/chat_id incomplete; fill both under herald.telegram"
		return 1
	fi

	mkdir -p "$(dirname "$CONF_RENDERED")" "$(dirname "$db_path")"
	{
		echo "server:"
		echo "  addr: \"$http_addr:$http_port\""
		echo "auth:"
		if [ -n "$api_key" ]; then
			echo "  enabled: true"
			echo "  api_keys:"
			echo "    \"$api_key\": \"operator\""
		else
			echo "  enabled: false"
		fi
		echo "  store_path: \"$db_path\""
		echo "providers:"
		echo "  log:"
		echo "    type: log"
		echo "    enabled: true"
		echo "    config:"
		echo "      name: \"$log_name\""
		if [ "$tg_enabled" = "1" ]; then
			echo "  telegram:"
			echo "    type: telegram"
			echo "    enabled: true"
			echo "    config:"
			echo "      token: \"$tg_token\""
			echo "      chat_id: \"$tg_chat_id\""
		fi
		echo "routes:"
		if [ "$tg_enabled" = "1" ]; then
			echo "  error: [log, telegram]"
			echo "  warning: [log, telegram]"
			echo "  info: [log, telegram]"
		else
			echo "  error: [log]"
			echo "  warning: [log]"
			echo "  info: [log]"
		fi
		echo "queue:"
		echo "  type: memory"
		echo "  size: 10000"
		echo "  timeout: 5s"
		echo "retry:"
		echo "  max: 3"
		echo "  backoff: exponential"
		echo "  initial_delay: 1s"
		echo "  max_delay: 1m"
		echo "dedup:"
		echo "  enabled: true"
		echo "  window: 5m"
		echo "websocket:"
		# Loopback by construction: the worker channel carries no role on a
		# single-box router, and herald refuses a non-loopback websocket
		# without a shared token.
		echo "  addr: \"127.0.0.1:8081\""
	} > "$CONF_RENDERED"
	return 0
}

start_service() {
	local enabled mode
	config_load herald
	config_get enabled general enabled '0'
	[ "$enabled" = "1" ] || return 0
	config_get mode general mode 'simple'

	local conf
	if [ "$mode" = "advanced" ]; then
		conf="$CONF_ADVANCED"
		[ -s "$conf" ] || {
			logger -t herald "advanced mode but $conf missing/empty"
			return 1
		}
	else
		conf="$CONF_RENDERED"
		render_config || return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" serve --config "$conf"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	service_stop "$PROG"
}

reload_service() {
	stop
	start
}
