# Herald Environment Variables

# Authentication (optional, enable in config.yaml)
# HERALD_AUTH_ENABLED=true
# HERALD_AUTH_SECRET_KEY=your-secret-key-here
# HERALD_ADMIN_USER=admin
# HERALD_ADMIN_PASSWORD=admin
# HERALD_API_KEY=your-api-key-here
# HERALD_API_KEY_DESC=Admin API Key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Feishu (飞书)
FEISHU_WEBHOOK_URL=your_feishu_webhook_url

# WeChat Work (企业微信)
WECOM_WEBHOOK_URL=your_wecom_webhook_url

# DingTalk (钉钉)
DINGTALK_ACCESS_TOKEN=your_dingtalk_access_token
DINGTALK_SECRET=your_dingtalk_secret

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Discord
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email SMTP
EMAIL_USERNAME=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_email_address

# Generic Webhook
WEBHOOK_URL=https://your-webhook-url.com/herald

# Aliyun SMS (阿里云短信)
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_SMS_SIGN_NAME=your_aliyun_sms_sign_name

# Tencent Cloud SMS (腾讯云短信)
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_SMS_APP_ID=your_tencent_sms_app_id

# NetEase YunXin SMS (网易云信短信)
NETEASE_APP_KEY=your_netease_app_key
NETEASE_APP_SECRET=your_netease_app_secret

# WeChat Personal (微信个人推送)
# Server酱 (https://sct.ftqq.com/)
WECHAT_SERVERCHAN_SEND_KEY=your_serverchan_send_key

# PushPlus (http://www.pushplus.plus/)
WECHAT_PUSHPLUS_TOKEN=your_pushplus_token

# WxPusher (https://wxpusher.zjiecode.com/)
WECHAT_WXPUSHER_APP_TOKEN=your_wxpusher_app_token
WECHAT_WXPUSHER_UID=your_wxpusher_uid

# WeChat Official Account (微信公众号)
WECHATMP_APP_ID=wx1234567890abcdef
WECHATMP_APP_SECRET=abcdef1234567890abcdef
WECHATMP_TEMPLATE_ID=AT0001
WECHATMP_DEFAULT_URL=https://your-domain.com
