# Herald Environment Variables

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Feishu (飞书)
FEISHU_WEBHOOK_URL=your_feishu_webhook_url

# WeChat Work (企业微信)
WECOM_WEBHOOK_URL=your_wecom_webhook_url

# DingTalk (钉钉)
DINGTALK_ACCESS_TOKEN=your_dingtalk_access_token
DINGTALK_SECRET=your_dingtalk_secret

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Discord
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email SMTP
EMAIL_USERNAME=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your_email_address

# Generic Webhook
WEBHOOK_URL=https://your-webhook-url.com/herald

# Aliyun SMS (阿里云短信)
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_SMS_SIGN_NAME=your_aliyun_sms_sign_name

# Tencent Cloud SMS (腾讯云短信)
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_SMS_APP_ID=your_tencent_sms_app_id

# NetEase YunXin SMS (网易云信短信)
NETEASE_APP_KEY=your_netease_app_key
NETEASE_APP_SECRET=your_netease_app_secret
